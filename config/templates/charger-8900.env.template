# The wrapper recreates .private/charger-8900.env from this template when missing.
# The real charger-8900.env file is outside the root *.env startup glob,
# ignored by git, and kept chmod 600.

CHARGER_8900_HOST=192.168.129.191
CHARGER_8900_PORT=8900
CHARGER_8900_INTERFACE=eth0

# Optional explicit URL. Leave blank to derive from host and port.
CHARGER_8900_URL=

# Fill these locally when you have valid HTTP Basic auth credentials.
CHARGER_8900_USER=
CHARGER_8900_PASSWORD=

# Keep these short; the charger-side web server appears embedded/thttpd.
CHARGER_8900_CONNECT_TIMEOUT=1
CHARGER_8900_MAX_TIME=2
CHARGER_8900_LOG_DIR=logs/charger_8900_manual
