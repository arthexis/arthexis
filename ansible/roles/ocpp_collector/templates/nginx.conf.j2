server {
{% if ocpp_collector_tls_certificate | length > 0 %}
    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate {{ ocpp_collector_tls_certificate }};
    ssl_certificate_key {{ ocpp_collector_tls_certificate_key }};
{% else %}
    listen 80;
    listen [::]:80;
{% endif %}
    server_name {{ ocpp_collector_hostname }};

    location / {
        proxy_pass http://{{ ocpp_collector_listen_host }}:{{ ocpp_collector_listen_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
