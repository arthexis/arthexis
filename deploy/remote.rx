# Watchtower remote access service and policy deployment.
# Public DNS/TLS exposure and acceptance are composed separately.

# Apply the checked-in named-scope policy idempotently.
security scope apply deploy/mcp-scopes.toml

security scope show chatgpt-logs

# Both services resolve the project semantic cache_dir and share its durable security registry.
service install
--backend systemd
--system
--name mcp-server
--
./mcp-server.rx

service restart
--system
--name mcp-server
--timeout 40
--
./mcp-server.rx

# remote.serve carries the built-in stable service identity "remote-auth".
service install
--backend systemd
--system
--
remote serve 127.0.0.1 8001 --public-origin https://remote.arthexis.com --resource-path /mcp

service restart
--system
--timeout 40
--
remote serve 127.0.0.1 8001 --public-origin https://remote.arthexis.com --resource-path /mcp
