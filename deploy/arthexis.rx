# Arthexis public application deployment for Watchtower.
# The systemd service must already be installed and active before this recipe runs.
./ready.rx

ingest curl --kind proc

recipe web/expose
--site arthexis.com
--domain arthexis.com
--host 127.0.0.1
--port 8888
--email [email]

curl --fail --silent --show-error --retry 5 --retry-delay 1 --retry-all-errors --
https://[domain|arthexis.com][health_path|/health/]
