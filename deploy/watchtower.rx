# Watchtower deployment composition.
# Keep the public Arthexis application and remote access surface as separate
# child deployments so each can evolve and recover independently.
./arthexis.rx

./remote-expose.rx

recipe wire/watchtower
--email [email]
--public-address [public_ipv4]

# The Wire recipe owns a systemd enrollment service; fail at composition time
# if service installation silently failed to materialize its unit.
check path /etc/systemd/system/gway-wire-enroll.service
