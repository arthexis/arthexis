# Arthexis Watchtower public deployment.
# The systemd service must already be installed and active before this recipe runs.
./ready.rx

ingest curl --kind proc

recipe web/expose
--name [name|arthexis]
--domain [domain|arthexis.com]
--host [host|127.0.0.1]
--port [port|8888]
--email [email]

curl --fail --silent --show-error
https://[domain|arthexis.com][health_path|/health/]
